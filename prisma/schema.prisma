// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Climate {
  TROPICAL
  COLD
  DRY
  MODERATE
}

enum TravelStyle {
  ADVENTURE
  RELAXATION
  CULTURAL
  BUSINESS
  NIGHTLIFE
}

enum BudgetRange {
  BUDGET
  MID_RANGE
  LUXURY
}

enum GroupType {
  SOLO
  COUPLE
  FAMILY
  FRIENDS
}

model User {
  id        Int    @id @default(autoincrement())
  email     String @unique
  password  String 
  firstName String
  lastName  String

  // Preferences
  preferredClimate     Climate
  travelStyle          TravelStyle
  preferredActivities  String[]
  preferredRegions     String[]

  // Finances
  budgetRange  BudgetRange
  currency     String?      @default("USD")

  // Travel Info
  homeCountry  String
  groupType    GroupType?

  // Auth
  refreshToken String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  reviews HotelReviews[]
  likes   ReviewLike[]
}

model Hotel {
  id            Int     @id @default(autoincrement())
  name          String
  city          String
  country       String
  description   String
  stars         Int
  pricePerNight Float
  image         String?
  tags          String[] 

  reviews HotelReviews[]
  searchHistory HotelSearchHistory[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model HotelSearchHistory {
  id        Int      @id @default(autoincrement())
  query     String
  hotelId   Int?
  hotel     Hotel?   @relation(fields: [hotelId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([hotelId])
}

model HotelReviews {
  id        Int      @id @default(autoincrement())
  hotelId   Int
  userId    Int
  rating    Int
  review    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  hotel Hotel @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  likes ReviewLike[] 

  @@unique([hotelId, userId])
}

model ReviewLike {
  id       Int @id @default(autoincrement())
  reviewId Int
  userId   Int

  review HotelReviews @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  user   User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([reviewId, userId])
}
